<section class="bs-max-w-7xl bs-mx-auto bs-px-6 bs-py-16">

    <!-- Heading -->
    <div class="bs-flex bs-justify-between bs-items-center bs-mb-10">

        <div>

            <span class="bs-inline-block bs-bg-blue-100 bs-text-blue-600 bs-px-4 bs-py-2 bs-rounded-full bs-font-semibold">
                BlogSphere
            </span>

            <h1 class="bs-text-5xl bs-font-bold bs-mt-4">
                My Blogs
            </h1>

            <p class="bs-text-gray-600 bs-mt-3">
                Manage all the blogs you've written.
            </p>

        </div>

        <a
            href="/host/add-blog"
            class="bs-bg-blue-600 bs-text-white bs-px-6 bs-py-3 bs-rounded-xl bs-hover-bg-blue-700 bs-transition"
        >
            + Add Blog
        </a>

    </div>

    <% if(posts.length === 0){ %>

        <div class="bs-bg-white bs-rounded-2xl bs-shadow-lg bs-p-12 bs-text-center">

            <h2 class="bs-text-3xl bs-font-bold">
                No Blogs Yet
            </h2>

            <p class="bs-text-gray-500 bs-mt-4">
                Start sharing your knowledge with the community.
            </p>

            <a
                href="/host/add-blog"
                class="bs-inline-block bs-mt-8 bs-bg-blue-600 bs-text-white bs-px-6 bs-py-3 bs-rounded-xl bs-hover-bg-blue-700 bs-transition"
            >
                Create Your First Blog
            </a>

        </div>

    <% } else { %>

        <div class="bs-overflow-x-auto bs-bg-white bs-rounded-2xl bs-shadow-lg">

            <table class="bs-min-w-full">

                <thead class="bs-bg-gray-100">

                    <tr>

                        <th class="bs-px-6 bs-py-4 bs-text-left">
                            Title
                        </th>

                        <th class="bs-px-6 bs-py-4 bs-text-left">
                            Created
                        </th>

                        <th class="bs-px-6 bs-py-4 bs-text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% posts.forEach(post => { %>

                        <tr class="bs-border-t bs-hover-bg-gray-50">

                            <td class="bs-px-6 bs-py-5 bs-font-medium">
                                <%= post.title %>
                            </td>

                            <td class="bs-px-6 bs-py-5 bs-text-gray-500">
                                <%= post.createdAt.toDateString() %>
                            </td>

                            <td class="bs-px-6 bs-py-5">

                                <div class="bs-flex bs-justify-center bs-gap-3">

                                    <a
                                        href="/blogs/<%= post._id %>"
                                        class="bs-bg-green-500 bs-hover-bg-green-600 bs-text-white bs-px-4 bs-py-2 bs-rounded-lg bs-transition"
                                    >
                                        View
                                    </a>

                                    <a
                                        href="/host/edit-blog/<%= post._id %>"
                                        class="bs-bg-yellow-500 bs-hover-bg-yellow-600 bs-text-white bs-px-4 bs-py-2 bs-rounded-lg bs-transition"
                                    >
                                        Edit
                                    </a>

                                    <form
                                        action="/host/delete-blog/<%= post._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this blog?');"
                                    >

                                        <button
                                            type="submit"
                                            class="bs-bg-red-600 bs-hover-bg-red-700 bs-text-white bs-px-4 bs-py-2 bs-rounded-lg bs-transition"
                                        >
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</section>