<% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div class="bs-bg-red-100 bs-border bs-border-red-400 bs-text-red-700 bs-px-4 bs-py-3 bs-rounded bs-relative" role="alert">
          <ul class="bs-list-disc bs-pl-5">
            <% error.forEach(err => { %>
              <li><%= err %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>