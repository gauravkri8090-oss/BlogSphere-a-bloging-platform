<section class="bs-min-h-80vh bs-flex bs-items-center bs-justify-center bs-px-6">

    <div class="bs-text-center bs-max-w-2xl bs-pt-14">

        <!-- 404 Badge -->
        <span class="bs-inline-block bs-bg-red-100 bs-text-red-600 bs-px-5 bs-py-2 bs-rounded-full bs-font-semibold">
            Error 404
        </span>

        <!-- Heading -->
        <h1 class="bs-mt-8 bs-text-7xl bs-md-text-8xl bs-font-black bs-text-gray-900">
            Oops!
        </h1>

        <h2 class="bs-mt-4 bs-text-4xl bs-font-bold">
            Page Not Found
        </h2>

        <!-- Description -->
        <p class="bs-mt-6 bs-text-lg bs-text-gray-600 bs-leading-8">

            The page you're looking for doesn't exist,
            may have been moved, or the URL is incorrect.

        </p>

        <!-- Buttons -->
        <div class="bs-mt-10 bs-flex bs-flex-wrap bs-justify-center bs-gap-5">

            <a
                href="/"
                class="bs-bg-blue-600 bs-hover-bg-blue-700 bs-text-white bs-px-8 bs-py-3 bs-rounded-xl bs-transition"
            >
                Back to Home
            </a>

            <a
                href="/blogs"
                class="bs-border bs-border-gray-300 bs-hover-bg-gray-100 bs-px-8 bs-py-3 bs-rounded-xl bs-transition"
            >
                Browse Blogs
            </a>

        </div>

        <!-- Error Code -->
        <p class="bs-mt-14 bs-text-9xl bs-font-black bs-text-gray-100 bs-select-none">

            404

        </p>

    </div>

</section>