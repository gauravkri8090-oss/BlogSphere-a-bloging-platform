<section class="bs-max-w-7xl bs-mx-auto bs-px-6 bs-py-16">

    <!-- Hero -->

    <div class="bs-text-center bs-max-w-3xl bs-mx-auto">

        <span class="bs-inline-block bs-bg-blue-100 bs-text-blue-600 bs-px-5 bs-py-2 bs-rounded-full bs-font-semibold">
            Contact Us
        </span>

        <h1 class="bs-text-5xl bs-font-black bs-mt-6">
            We'd Love to Hear From You
        </h1>

        <p class="bs-mt-6 bs-text-lg bs-text-gray-600 bs-leading-8">

            Have a question, suggestion, or feedback?
            Fill out the form below and we'll get back to you as soon as possible.

        </p>

    </div>

    <!-- Content -->

    <div class="bs-grid bs-lg-grid-cols-2 bs-gap-12 bs-mt-16">

        <!-- Contact Form -->

        <div class="bs-bg-white bs-shadow-lg bs-rounded-3xl bs-p-8">

            <h2 class="bs-text-3xl bs-font-bold bs-mb-8">
                Send a Message
            </h2>

            <form action="#" method="POST" class="bs-space-y-6">

                <div>

                    <label
                        for="name"
                        class="bs-block bs-mb-2 bs-font-semibold"
                    >
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        class="bs-w-full bs-border bs-rounded-xl bs-px-4 bs-py-3 bs-focus-outline-none bs-focus-ring-2 bs-focus-ring-blue-500"
                        placeholder="John Doe"
                    >

                </div>

                <div>

                    <label
                        for="email"
                        class="bs-block bs-mb-2 bs-font-semibold"
                    >
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        class="bs-w-full bs-border bs-rounded-xl bs-px-4 bs-py-3 bs-focus-outline-none bs-focus-ring-2 bs-focus-ring-blue-500"
                        placeholder="john@example.com"
                    >

                </div>

                <div>

                    <label
                        for="subject"
                        class="bs-block bs-mb-2 bs-font-semibold"
                    >
                        Subject
                    </label>

                    <input
                        type="text"
                        id="subject"
                        name="subject"
                        class="bs-w-full bs-border bs-rounded-xl bs-px-4 bs-py-3 bs-focus-outline-none bs-focus-ring-2 bs-focus-ring-blue-500"
                        placeholder="What's this about?"
                    >

                </div>

                <div>

                    <label
                        for="message"
                        class="bs-block bs-mb-2 bs-font-semibold"
                    >
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        required
                        class="bs-w-full bs-border bs-rounded-xl bs-px-4 bs-py-3 bs-resize-none bs-focus-outline-none bs-focus-ring-2 bs-focus-ring-blue-500"
                        placeholder="Write your message..."
                    ></textarea>

                </div>

                <button
                    class="bs-bg-blue-600 bs-hover-bg-blue-700 bs-text-white bs-px-8 bs-py-3 bs-rounded-xl bs-transition"
                >
                    Send Message
                </button>

            </form>

        </div>

        <!-- Contact Info -->

        <div>

            <div class="bs-bg-white bs-shadow-lg bs-rounded-3xl bs-p-8">

                <h2 class="bs-text-3xl bs-font-bold bs-mb-8">
                    Get In Touch
                </h2>

                <div class="bs-space-y-6">

                    <div>

                        <h3 class="bs-font-semibold bs-text-blue-600">
                            📧 Email
                        </h3>

                        <p class="bs-text-gray-600 bs-mt-2">
                            support@blogsphere.com
                        </p>

                    </div>

                    <div>

                        <h3 class="bs-font-semibold bs-text-blue-600">
                            🌍 Website
                        </h3>

                        <p class="bs-text-gray-600 bs-mt-2">
                            www.blogsphere.com
                        </p>

                    </div>

                    <div>

                        <h3 class="bs-font-semibold bs-text-blue-600">
                            💻 Technologies
                        </h3>

                        <p class="bs-text-gray-600 bs-mt-2">
                            Node.js • Express • MongoDB • EJS • Custom CSS
                        </p>

                    </div>

                </div>

            </div>

            <!-- FAQ -->

            <div class="bs-bg-blue-600 bs-text-white bs-rounded-3xl bs-p-8 bs-mt-8">

                <h2 class="bs-text-2xl bs-font-bold">
                    Need Help?
                </h2>

                <p class="bs-mt-4 bs-leading-8 bs-text-blue-100">

                    We usually respond to all inquiries within
                    <strong>24 hours</strong>. Whether you're reporting a bug,
                    suggesting a feature, or just saying hello, we'd love to
                    hear from you.

                </p>

            </div>

        </div>

    </div>

</section>